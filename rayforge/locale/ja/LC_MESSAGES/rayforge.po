#: rayforge/machine/driver/grbl/grbl_telnet.py rayforge/machine/driver/grbl/grbl_serial.py
msgid "Periodically query the device for position and status while a job is running. Warning: Some devices have trouble maintaining a stable connection if this is used!"
msgstr "加工ジョブの実行中、定期的にデバイスの位置とステータスを照会します。警告: これを使用すると、一部のデバイスで安定した接続を維持できなくなる場合があります。"

#: rayforge/machine/driver/grbl/grbl_telnet.py rayforge/machine/driver/grbl/grbl_serial.py
msgid "Deadlock detection"
msgstr "デッドロック検出"

#: rayforge/machine/driver/grbl/grbl_telnet.py rayforge/machine/driver/grbl/grbl_serial.py
msgid "Detect and recover from serial communication deadlocks during jobs. If disabled, the driver will simply wait for the machine to respond. Disable if you experience false ALARM:3 errors."
msgstr "ジョブ中のシリアル通信のデッドロックを検出して復旧します。無効にすると、ドライバはマシンの応答を単に待ち続けます。誤った ALARM:3 エラーが発生する場合は無効にしてください。"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Missing Command Letter"
msgstr "コマンド文字がありません"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "G-code commands need a letter followed by a value. The command letter was not found."
msgstr "Gコードコマンドには、文字の後に値を続ける必要があります。コマンド文字が見つかりませんでした。"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Invalid Number Format"
msgstr "無効な数値形式です"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "The value is missing or not in the correct numeric format. Check your G-code syntax."
msgstr "値が欠落しているか、正しい数値形式ではありません。Gコードの構文を確認してください。"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Unknown Command"
msgstr "不明なコマンド"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "This Grbl setting command is not recognized or supported. Check the command syntax."
msgstr "このGrbl設定コマンドは認識されないか、サポートされていません。コマンドの構文を確認してください。"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Negative Value"
msgstr "負の値です"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "A positive number is required here, but a negative value was received."
msgstr "ここでは正の数が必要ですが、負の値が入力されました。"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Homing Disabled"
msgstr "ホーミングが無効です"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Homing is not enabled in settings. Enable homing ($22=1) to use this feature."
msgstr "設定でホーミングが有効になっていません。この機能を使用するにはホーミングを有効にしてください ($22=1)。"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Pulse Time Too Short"
msgstr "パルス時間が短すぎます"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Minimum step pulse time must be greater than 3 microseconds. Check setting $0."
msgstr "最小ステップパルス時間は3マイクロ秒より長くする必要があります。設定 $0 を確認してください。"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Memory Error"
msgstr "メモリエラー"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Settings reset to defaults due to a memory read failure. Reconfigure your settings if needed."
msgstr "メモリ読み込みエラーのため、設定がデフォルトにリセットされました。必要に応じて設定を再構成してください。"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Machine Busy"
msgstr "マシンはビジー状態です"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "This command can only be used when the machine is idle. Wait for the current job to finish."
msgstr "このコマンドはマシンがアイドルのときにのみ使用できます。現在のジョブが終了するまでお待ちください。"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Commands Locked"
msgstr "コマンドがロックされています"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Cannot send commands while in alarm or jog mode. Clear the alarm state first."
msgstr "アラームまたはジョグモード中はコマンドを送信できません。最初にアラーム状態を解除してください。"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Homing Required"
msgstr "ホーミングが必要です"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Soft limits cannot be enabled without homing also enabled. Enable homing first ($22=1)."
msgstr "ソフトリミットは、ホーミングも有効にしないと有効にできません。最初にホーミングを有効にします ($22=1)。"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Line Too Long"
msgstr "行が長すぎます"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "The command line has too many characters and was ignored. Check your file formatting."
msgstr "コマンドラインの文字数が多すぎるため、無視されました。ファイルの形式を確認してください。"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Setting Too High"
msgstr "設定が高すぎます"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "This setting exceeds the maximum step rate supported. Use a lower value."
msgstr "この設定はサポートされている最大ステップレートを超えています。より低い値を使用してください。"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Door Open"
msgstr "ドアが開いています"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "The safety door was detected as open. Close the door and resume operation."
msgstr "安全ドアが開いていることが検出されました。ドアを閉じて操作を再開してください。"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Build info or startup line exceeds storage limit. Shorten the line."
msgstr "ビルド情報またはスタートアップ行がストレージ制限を超えています。行を短くしてください。"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Target Out of Range"
msgstr "ターゲットが範囲外です"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Jog target is beyond the machine's travel limits. Move to a position within range."
msgstr "ジョグの目標位置がマシンの移動限界を超えています。範囲内の位置に移動してください。"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Invalid Jog Command"
msgstr "無効なジョグコマンドです"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Jog command is missing '=' or contains prohibited G-code. Check the jog syntax."
msgstr "ジョグコマンドに '=' が抜けているか、禁止されているGコードが含まれています。ジョグの構文を確認してください。"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Laser Mode Error"
msgstr "レーザーモードエラー"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Laser mode requires PWM output to work. Check your hardware configuration."
msgstr "レーザーモードの動作にはPWM出力が必要です。ハードウェア構成を確認してください。"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Spindle Not Running"
msgstr "スピンドルが回転していません"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "A motion command was issued but the spindle is not running. Start the spindle before motion."
msgstr "移動コマンドが発行されましたが、スピンドルが回転していません。移動前にスピンドルを起動してください。"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Spindle Speed Mismatch"
msgstr "スピンドル速度が一致しません"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "The current spindle speed does not match the speed required by the command. Wait for the spindle to reach the target speed."
msgstr "現在のスピンドル速度がコマンドに必要な速度と一致していません。スピンドルが目標速度に達するまでお待ちください。"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Unsupported Command"
msgstr "サポートされていないコマンドです"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "This G-code command is not supported by the machine. Check your post-processor settings."
msgstr "このGコードコマンドはマシンでサポートされていません。ポストプロセッサの設定を確認してください。"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Conflicting Commands"
msgstr "競合するコマンドです"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Multiple commands from the same group found on one line. Remove the duplicate command."
msgstr "同じグループの複数のコマンドが1行に複数見つかりました。重複したコマンドを削除してください。"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Feed Rate Missing"
msgstr "送り速度がありません"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Set a feed rate before using motion commands. Add an F command to specify speed."
msgstr "移動コマンドを使用する前に送り速度を設定してください。速度を指定するためにFコマンドを追加してください。"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Integer Required"
msgstr "整数が必要です"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "This command requires a whole number value. Remove any decimal points."
msgstr "このコマンドには整数値が必要です。小数点以下を削除してください。"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Axis Conflict"
msgstr "軸の競合です"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Multiple commands trying to use the same axis. Simplify the command."
msgstr "複数のコマンドが同じ軸を使用しようとしています。コマンドを簡略化してください。"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Duplicate Word"
msgstr "重複したワード"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "The same G-code word appears more than once. Remove the duplicate."
msgstr "同じGコードワードが複数回出現しています。重複を削除してください。"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Missing Axis"
msgstr "軸の欠落"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "This command requires XYZ axis coordinates. Add the missing axis values."
msgstr "このコマンドにはXYZ軸の座標が必要です。不足している軸の値を追加してください。"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Line Number Out of Range"
msgstr "行番号が範囲外です"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Line number must be between 1 and 9,999,999. Use a valid line number."
msgstr "行番号は1から9,999,999の間である必要があります。有効な行番号を使用してください。"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Missing Value"
msgstr "値の欠落"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "This command requires a P or L value. Add the missing parameter."
msgstr "このコマンドにはPまたはLの値が必要です。不足しているパラメータを追加してください。"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Unsupported Coordinate"
msgstr "サポートされていない座標"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Only G54-G59 coordinate systems are supported. Use one of these instead."
msgstr "G54〜G59座標系のみがサポートされています。代わりにこれらのいずれかを使用してください。"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Wrong Motion Mode"
msgstr "間違ったモーションモード"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "G53 command requires G0 or G1 motion mode. Set the correct motion mode first."
msgstr "G53コマンドにはG0またはG1モーションモードが必要です。最初に正しいモーションモードを設定してください。"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Unused Axis Words"
msgstr "未使用の軸ワード"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Axis words present but G80 cancel is active. Remove the unused axis words."
msgstr "軸ワードが存在しますが、G80キャンセルが有効になっています。未使用の軸ワードを削除してください。"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Missing Arc Data"
msgstr "円弧データの欠落"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "G2/G3 arc command needs XYZ coordinates. Add the axis values for the selected plane."
msgstr "G2/G3円弧コマンドにはXYZ座標が必要です。選択した平面の軸の値を追加してください。"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Invalid Target"
msgstr "無効なターゲット"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Cannot create this arc or probe to current position. Check the target coordinates."
msgstr "この円弧を作成できないか、現在位置へのプロービングができません。ターゲット座標を確認してください。"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Arc Geometry Error"
msgstr "円弧ジオメトリエラー"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Arc calculation failed. Try breaking the arc into smaller pieces or use IJK offset instead."
msgstr "円弧の計算に失敗しました。円弧をより小さなパーツに分割するか、代わりにIJKオフセットを使用してみてください。"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Missing Arc Offset"
msgstr "円弧オフセットの欠落"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "G2/G3 arc command needs IJK offset values. Add the missing offset for the selected plane."
msgstr "G2/G3円弧コマンドにはIJKオフセット値が必要です。選択した平面の不足しているオフセットを追加してください。"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Unused Words"
msgstr "未使用のワード"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Some G-code words in this line are not used by any command. Remove the unused words."
msgstr "この行の一部のGコードワードはどのコマンドからも使用されていません。未使用のワードを削除してください。"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Wrong Axis for Offset"
msgstr "オフセットの軸が不正です"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Tool length offset only works on the configured axis (usually Z-axis). Check your settings."
msgstr "工具長補正は設定された軸（通常はZ軸）でのみ機能します。設定を確認してください。"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Tool Number Too High"
msgstr "ツール数が多すぎます"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Tool number exceeds the maximum supported value. Use a valid tool number."
msgstr "ツール番号がサポートされている最大値を超えています。有効な工具番号を使用してください。"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Hard Limit"
msgstr "ハードリミット"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "A hard limit switch was triggered. The machine has stopped and needs to be reset. Check for obstructions and verify your limit switches."
msgstr "ハードリミットスイッチが作動しました。マシンが停止したため、リセットする必要があります。障害物がないか確認し、リミットスイッチを点検してください。"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Soft Limit"
msgstr "ソフトリミット"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "The machine would move beyond its configured travel limits. Check that your work area and coordinate offsets are correct."
msgstr "マシンが設定された移動制限を超えて移動しようとしました。加工エリアと座標オフセットが正しいか確認してください。"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Abort Cycle"
msgstr "サイクルの中止"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "The currently running job was cancelled while in motion. Reset the machine to continue."
msgstr "実行中のジョブが動作中にキャンセルされました。続行するにはマシンをリセットしてください。"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Probe Fail — Initial"
msgstr "プローブ失敗 — 初期"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "The probe did not make contact before the maximum travel distance was reached. Check the probe wiring and positioning."
msgstr "最大移動距離に達する前にプローブが接触しませんでした。プローブの配線と位置を確認してください。"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Probe Fail — Final"
msgstr "プローブ失敗 — 最終"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "The probe failed to retract to the target position after contact. Check the probe configuration."
msgstr "接触後、プローブがターゲット位置まで後退するのに失敗しました。プローブの設定を確認してください。"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Homing Fail — Reset"
msgstr "ホーミング失敗 — リセット"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Homing was not able to complete because the machine is in an alarm state. Clear the alarm and try again."
msgstr "マシンがアラーム状態のため、ホーミングを完了できませんでした。アラームを解除してもう一度やり直してください。"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Homing Fail — Approach"
msgstr "ホーミング失敗 — アプローチ"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "The homing cycle failed to find the switch within the configured travel distance. Check your switch wiring and pull-off settings."
msgstr "ホーミングサイクルが設定された移動距離内でスイッチを検出できませんでした。スイッチの配線とプルオフ設定を確認してください。"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Homing Fail — Pulloff"
msgstr "ホーミング失敗 — プルオフ"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "The homing cycle failed to successfully pull off the switch after contact. Increase the pull-off distance or check the switch."
msgstr "接触後、ホーミングサイクルのスイッチからのプルオフに失敗しました。プルオフ距離を増やすか、スイッチを確認してください。"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Home Without Limits"
msgstr "リミットなしでの原点復帰"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Homing was commanded but limit switches are not configured. Enable limit switches first."
msgstr "原点復帰が指令されましたが、リミットスイッチが設定されていません。最初にリミットスイッチを有効にしてください。"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Homing Fail — Dual Axis"
msgstr "ホーミング失敗 — 2 軸"

#: rayforge/machine/driver/grbl/grbl_util.py
msgid "Homing failed on a dual-axis configuration. One or both axes did not reach their limit switches. Check your limit switch wiring and configuration."
msgstr "2 軸構成でホーミングが失敗しました。1 つまたは両方の軸がリミット スイッチに到達しませんでした。リミットスイッチの配線と構成を確認してください。"

