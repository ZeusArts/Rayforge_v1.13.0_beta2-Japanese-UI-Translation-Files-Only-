msgstr "マーカーをドラッグして黒/白点を設定します"

#: laser_essentials/steps/laser_step.py
msgid ""
"Laser head used for this step; the machine's first head is used when unset"
msgstr "このステップで使用するレーザーヘッド。"
"未設定の場合はマシンの最初のヘッドが使用されます"

#: laser_essentials/steps/laser_step.py
msgid "Laser power as a percentage"
msgstr "パーセンテージで表したレーザー出力"

#: laser_essentials/steps/laser_step.py
msgid "Power Mode"
msgstr "出力モード"

#: laser_essentials/steps/laser_step.py
msgid ""
"Dynamic power (M4) scales power with head speed; constant power (M3) keeps "
"it fixed. Use constant power if corners and curves burn too lightly"
msgstr "ダイナミック出力（M4）はヘッド速度に応じて出力をスケーリングし、"
"定出力（M3）は一定に保ちます。コーナーや曲線が薄く焼き付く場合は定出力を使用してください"

#: laser_essentials/steps/laser_step.py
msgid "Dynamic (M4)"
msgstr "ダイナミック（M4）"

#: laser_essentials/steps/laser_step.py
msgid "Constant (M3)"
msgstr "定出力（M3）"

#: laser_essentials/steps/laser_step.py
msgid "Air Assist"
msgstr "エアアシスト"

#: laser_essentials/steps/laser_step.py
msgid "Blow air over the cut to clear debris"
msgstr "切断部に空気を送り込んでゴミを除去します"

#: laser_essentials/steps/laser_step.py
msgid "Tab Power"
msgstr "タブ出力"

#: laser_essentials/steps/laser_step.py
msgid "Laser power at tab positions as a percentage"
msgstr "パーセンテージで表したタブ位置でのレーザー出力"

#: laser_essentials/steps/laser_step.py
msgid "Frequency"
msgstr "周波数"

#: laser_essentials/steps/laser_step.py
msgid "Laser pulse frequency in Hz (0 = head default)"
msgstr "Hz単位のレーザーパルス周波数（0 = ヘッドデフォルト）"

#: laser_essentials/steps/laser_step.py
msgid "Pulse Width"
msgstr "パルス幅"

#: laser_essentials/steps/laser_step.py
msgid "Laser pulse width in ns (0 = head default)"
msgstr "ns単位のレーザーパルス幅（0 = ヘッドデフォルト）"

#: laser_essentials/steps/laser_step.py
msgid "Step Settings"
msgstr "ステップ設定"

#: laser_essentials/steps/laser_step.py
#, python-brace-format
msgid "{power_percent}% power, {speed_str}"
msgstr "出力 {power_percent}%、{speed_str}"

#: laser_essentials/steps/shrinkwrap_step.py
msgid "Gravity"
msgstr "グラビティ"

#: laser_essentials/steps/shrinkwrap_step.py
msgid "Pulls the hull inward. 0.0 is a standard convex hull"
msgstr "外郭を内側に引き寄せます。0.0は標準的な凸包です"

#: laser_essentials/steps/shrinkwrap_step.py
#: laser_essentials/steps/frame_step.py laser_essentials/steps/contour_step.py
msgid "Cut Side"
msgstr "切断側"

#: laser_essentials/steps/shrinkwrap_step.py
#: laser_essentials/steps/wavefront_step.py
#: laser_essentials/steps/frame_step.py
#: laser_essentials/steps/offset_fill_step.py
#: laser_essentials/steps/contour_step.py
msgid "Offset"
msgstr "オフセット"

#: laser_essentials/steps/shrinkwrap_step.py
msgid ""
"Shifts the contour inward/outward per Cut Side (none on Centerline). "
"Defaults to kerf compensation for the head"
msgstr "切断側（センターラインではない）に従って輪郭を内側/外側へシフトします。"
"デフォルトではヘッドのカーフ補正を使用します"

#: laser_essentials/steps/wavefront_step.py
msgid "Step Over"
msgstr "ステップオーバー"

#: laser_essentials/steps/wavefront_step.py
msgid "Lateral step-over between wavefront passes"
msgstr "ウェーブフロントパス間の横方向のステップオーバー"

#: laser_essentials/steps/wavefront_step.py
msgid "Extra offset from walls"
msgstr "壁からの追加のオフセット"

#: laser_essentials/steps/frame_step.py
msgid "Frame"
msgstr "フレーム"

#: laser_essentials/steps/frame_step.py
msgid ""
"Shifts the frame inward/outward per Cut Side (none on Centerline). Defaults "
"to kerf compensation for the head"
msgstr "切断側（センターラインではなし）に従ってフレームを内側/外側へシフトします。"
"デフォルトではヘッドのカーフ補正を使用します"

#: laser_essentials/steps/frame_step.py
msgid "Round Corners"
msgstr "角を丸める"

#: laser_essentials/steps/frame_step.py
msgid "Round the frame's corners instead of cutting right angles"
msgstr "直角に切断する代わりにフレームの角を丸めます"

#: laser_essentials/steps/frame_step.py
msgid "Corner Radius"
msgstr "コーナー半径"

#: laser_essentials/steps/frame_step.py
msgid "Radius used to round the frame's corners"
msgstr "フレームの角を丸めるために使用する半径"

#: laser_essentials/steps/offset_fill_step.py
#: laser_essentials/steps/material_test.py
msgid "Line Interval"
msgstr "ライン間隔"

#: laser_essentials/steps/offset_fill_step.py
msgid ""
"Distance between neighbouring fill rings. Defaults to the laser spot size"
msgstr "隣接する塗りつぶしリング間の距離。"
"デフォルトはレーザーのスポットサイズです"

#: laser_essentials/steps/offset_fill_step.py
msgid "Distance of the first ring inside the outline"
msgstr "輪郭の内側にある最初のリングの距離"

#: laser_essentials/steps/offset_fill_step.py
msgid "Fill Direction"
msgstr "塗りつぶし方向"

#: laser_essentials/steps/offset_fill_step.py
msgid "Order in which the rings are cut"
msgstr "リングが切断される順序"

#: laser_essentials/steps/raster_step.py
msgid "Mode"
msgstr "モード"

#: laser_essentials/steps/raster_step.py laser_essentials/steps/contour_step.py
msgid "Threshold"
msgstr "しきい値"

#: laser_essentials/steps/raster_step.py
msgid "Brightness cutoff for black/white (0-255)"
msgstr "白黒の明るさのカットオフ（0-255）"

#: laser_essentials/steps/raster_step.py
msgid "Engraving Method"
msgstr "彫刻方式"

#: laser_essentials/steps/raster_step.py
msgid "Algorithm for converting grayscale to binary"
msgstr "グレースケールを二値に変換するためのアルゴリズム"

#: laser_essentials/steps/raster_step.py
msgid "Serpentine"
msgstr "サーペンタイン"

#: laser_essentials/steps/raster_step.py
msgid ""
"Alternate the dither direction on every row to avoid directional artifacts"
msgstr "方向性のアーティファクトを避けるため、行ごとにディザ方向を交互にします"

#: laser_essentials/steps/raster_step.py
msgid "Halftone Cell Size"
msgstr "ハーフトーンセルサイズ"

#: laser_essentials/steps/raster_step.py
msgid "Distance between halftone dot centers"
msgstr "ハーフトーン網点中心間の距離"

#: laser_essentials/steps/raster_step.py
msgid "Halftone Angle"
msgstr "ハーフトーン角度"

#: laser_essentials/steps/raster_step.py
msgid "Rotation of the halftone dot grid"
msgstr "ハーフトーン網点グリッドの回転"

#: laser_essentials/steps/raster_step.py
msgid "Cross-Hatch"
msgstr "クロスハッチ"

#: laser_essentials/steps/raster_step.py
msgid "Add a second pass at 90 degrees"
msgstr "90度で2番目のパスを追加します"

#: laser_essentials/steps/raster_step.py
msgid "Scan Mode"
msgstr "スキャンモード"

#: laser_essentials/steps/raster_step.py
msgid "Segmented"
msgstr "セグメント化"

#: laser_essentials/steps/raster_step.py
msgid "Full Sweep"
msgstr "フルスウィープ"

#: laser_essentials/steps/raster_step.py
msgid ""
"Segmented: moves between content regions. Full Sweep: scans full width with "
"laser toggling"
msgstr "セグメント化: コンテンツ領域間を移動します。"
"フルスウィープ: レーザーのオン/オフを切り替えながら全幅をスキャンします"

#: laser_essentials/steps/raster_step.py
msgid "Line Spacing"
msgstr "ライン間隔"

#: laser_essentials/steps/raster_step.py
msgid "Distance between scan lines"
msgstr "スキャンライン間の距離"

#: laser_essentials/steps/raster_step.py
msgid "Sample Interval"
msgstr "サンプル間隔"

#: laser_essentials/steps/raster_step.py
msgid ""
"Distance between power samples along scan line. Lower values improve "
"accuracy, but increase output size"
msgstr "スキャンラインに沿った出力サンプルの間隔。"
"値を小さくすると精度が向上しますが、出力サイズが増加します"

#: laser_essentials/steps/raster_step.py
msgid "Dot Width Correction"
msgstr "ドット幅補正"

#: laser_essentials/steps/raster_step.py
msgid ""
"Reduces engrave length at both ends to compensate for physical dot width"
msgstr "物理的なドット幅を補正するために、両端の彫刻長を短縮します"

#: laser_essentials/steps/raster_step.py
msgid "Bidirectional Scan Offset"
msgstr "双方向スキャンオフセット"

#: laser_essentials/steps/raster_step.py
msgid ""
"Corrects X misalignment between left-to-right and right-to-left raster passes"
msgstr "左から右、および右から左へのラスターパス間のX軸のズレを補正します"

#: laser_essentials/steps/raster_step.py
msgid "Number of Depth Levels"
msgstr "深さレベル数"

#: laser_essentials/steps/raster_step.py
msgid "Z Step-Down per Level"
msgstr "レベルごとのZステップダウン"

#: laser_essentials/steps/raster_step.py
msgid "Rotate Angle Per Pass"
msgstr "パスごとの回転角度"

#: laser_essentials/steps/raster_step.py
msgid "Degrees to rotate each successive pass"
msgstr "連続する各パスを回転させる角度（度）"

#: laser_essentials/steps/raster_step.py
msgid "Auto Levels"
msgstr "オートレベル"

#: laser_essentials/steps/raster_step.py
msgid "Automatically adjust black/white points"
msgstr "黒/白点を自動的に調整します"

#: laser_essentials/steps/raster_step.py
msgid "White Point"
msgstr "白点"

#: laser_essentials/steps/raster_step.py
msgid "Min Power"
msgstr "最小出力"

#: laser_essentials/steps/raster_step.py
msgid "Max Power"
msgstr "最大出力"

#: laser_essentials/steps/raster_step.py
msgid "Power Levels"
msgstr "出力レベル"

#: laser_essentials/steps/raster_step.py
msgid "Number of discrete power steps (lower = fewer moves)"
msgstr "離散的な出力ステップの数（少ないほど移動が減ります）"

#: laser_essentials/steps/raster_step.py
#, python-brace-format
msgid "The {mode} depth mode is not supported by this machine's driver."
msgstr "{mode} 深さモードはこのマシンのドライバーでサポートされていません。"

#: laser_essentials/steps/contour_step.py
msgid "Contour"
msgstr "輪郭"

#: laser_essentials/steps/contour_step.py
msgid ""
"Shifts the cut path inward/outward per Cut Side (none on Centerline). "
"Defaults to kerf compensation for the head"
msgstr "切断側（センターラインではなし）に従って切断パスを内側/外側へシフトします。"
"デフォルトではヘッドのカーフ補正を使用します"

#: laser_essentials/steps/contour_step.py
msgid "Cut Order"
msgstr "切断順序"

#: laser_essentials/steps/contour_step.py
msgid "Processing order for nested paths"
msgstr "入れ子構造のパスの処理順序"

#: laser_essentials/steps/contour_step.py
msgid "Remove Inner Paths"
msgstr "内側のパスを削除"

#: laser_essentials/steps/contour_step.py
msgid "If enabled, only trace the outer outline of shapes"
msgstr "有効にすると、形状の外側の輪郭のみをトレースします"

#: laser_essentials/steps/contour_step.py
msgid "Overcut"
msgstr "オーバーカット"

#: laser_essentials/steps/contour_step.py
msgid ""
"Extend closed contours past their start point so the cut overlaps itself"
msgstr "閉じた輪郭を開始点を越えて延長し、切断部が重なるようにします"

#: laser_essentials/steps/contour_step.py
msgid "Rescan Content"
msgstr "コンテンツの再スキャン"

#: laser_essentials/steps/contour_step.py
msgid "Ignore source geometry and re-trace within the workpiece"
msgstr "ソースジオメトリを無視し、ワーク内で再トレースします"

#: laser_essentials/steps/contour_step.py
msgid "Brightness level (0.0-1.0) to define edges"
msgstr "エッジを定義するための明るさレベル（0.0-1.0）"

#: laser_essentials/steps/material_test.py
#: laser_essentials/commands/material_test_cmd.py
msgid "Material Test Grid"
msgstr "マテリアルテストグリッド"

#: laser_essentials/steps/material_test.py
msgid "Test Type"
msgstr "テストタイプ"

#: laser_essentials/steps/material_test.py
msgid "Cut: outlines; Engrave: fills with raster lines"
msgstr "切断: 輪郭線; 彫刻: ラスタラインで塗りつぶし"

#: laser_essentials/steps/material_test.py
msgid "Grid Mode"
msgstr "グリッドモード"

#: laser_essentials/steps/material_test.py
msgid "Choose which parameters to vary on axes"
msgstr "軸上で変化させるパラメータを選択します"

#: laser_essentials/steps/material_test.py
msgid "Grid Dimensions"
msgstr "グリッド寸法"

#: laser_essentials/steps/material_test.py
msgid "Columns"
msgstr "列"

#: laser_essentials/steps/material_test.py
msgid "Rows"
msgstr "行"

#: laser_essentials/steps/material_test.py
msgid "Shape Size"
msgstr "形状サイズ"

#: laser_essentials/steps/material_test.py
msgid "Size of each test square"
msgstr "各テストタイルのサイズ"

#: laser_essentials/steps/material_test.py
msgid "Spacing"
msgstr "間隔"

#: laser_essentials/steps/material_test.py
msgid "Gap between test squares"
msgstr "テストタイル間のギャップ"

#: laser_essentials/steps/material_test.py
msgid ""
"Distance between scan lines in machine units (for Engrave mode). Leave at 0 "
"to use laser spot size"
msgstr "マシン単位でのスキャンライン間の距離（彫刻モード用）。"
"レーザーのスポットサイズを使用するには 0 のままにしてください"

#: laser_essentials/steps/material_test.py
msgid "Include Labels"
msgstr "ラベルを含める"

#: laser_essentials/steps/material_test.py
msgid "Add speed/power annotations to the grid"
msgstr "グリッドに速度/出力の注記を追加します"

