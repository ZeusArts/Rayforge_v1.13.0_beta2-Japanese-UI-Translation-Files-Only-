#: print_and_cut/frontend.py
msgid "Align to Physical Position"
msgstr "物理位置に合わせる"

#: print_and_cut/wizard.py
msgid "Print & Cut"
msgstr "印刷してカット"

#: print_and_cut/wizard.py
msgid "Back"
msgstr "戻る"

#: print_and_cut/wizard.py
msgid "Reset"
msgstr "リセット"

#: print_and_cut/wizard.py
msgid "Cancel"
msgstr "キャンセル"

#: print_and_cut/wizard.py
msgid "Next"
msgstr "次へ"

#: print_and_cut/wizard.py
msgid "Apply"
msgstr "適用"

#: print_and_cut/wizard.py
msgid "Instructions"
msgstr "手順"

#: print_and_cut/wizard.py
msgid ""
"Click on two alignment points on the design. These will be matched to "
"physical locations in the next step."
msgstr ""
"デザイン上で2つの位置合わせポイントをクリックします。これらは次のステップで物理的な位置に一致させられます。"

#: print_and_cut/wizard.py
msgid "Picked Points"
msgstr "選択されたポイント"

#: print_and_cut/wizard.py
msgid "Point 1"
msgstr "ポイント 1"

#: print_and_cut/wizard.py
msgid "No point picked"
msgstr "ポイントが選択されていません"

#: print_and_cut/wizard.py
msgid "Point 2"
msgstr "ポイント 2"

#: print_and_cut/wizard.py
msgid "Status"
msgstr "ステータス"

#: print_and_cut/wizard.py
msgid "Click on the first alignment point on the design."
msgstr "デザイン上の最初の位置合わせポイントをクリックしてください。"

#: print_and_cut/wizard.py
msgid ""
"Jog the laser to the physical location of each point, then record the "
"position."
msgstr ""
"レーザーを各ポイントの物理的な位置までジョグ移動させ、その位置を記録します。"

#: print_and_cut/wizard.py
msgid "Jog Distance"
msgstr "ジョグ移動距離"

#: print_and_cut/wizard.py
msgid "Distance"
msgstr "距離"

#: print_and_cut/wizard.py
msgid "Distance Presets"
msgstr "距離プリセット"

#: print_and_cut/wizard.py
msgid "Toggle focus laser"
msgstr "フォーカスレーザーの切り替え"

#: print_and_cut/wizard.py
msgid "Focus Laser"
msgstr "フォーカスレーザー"

#: print_and_cut/wizard.py
msgid "Pointer Alignment"
msgstr "ポインター位置合わせ"

#: print_and_cut/wizard.py
msgid "Positions"
msgstr "位置"

#: print_and_cut/wizard.py
msgid "Record"
msgstr "記録"

#: print_and_cut/wizard.py
msgid "Go to recorded position"
msgstr "記録された位置へ移動"

#: print_and_cut/wizard.py
msgid "Position 1"
msgstr "位置 1"

#: print_and_cut/wizard.py
msgid "Not recorded"
msgstr "未記録"

#: print_and_cut/wizard.py
msgid "Position 2"
msgstr "位置 2"

#: print_and_cut/wizard.py
msgid "Laser Position"
msgstr "レーザー位置"

#: print_and_cut/wizard.py
msgid "X: --- Y: ---"
msgstr "X: --- Y: ---"

#: print_and_cut/wizard.py
msgid "Transform Preview"
msgstr "変換プレビュー"

#: print_and_cut/wizard.py
msgid "Review the computed alignment transform before applying it."
msgstr "適用する前に、計算された位置合わせ変換を確認してください。"

#: print_and_cut/wizard.py
msgid "Transform"
msgstr "変換"

#: print_and_cut/wizard.py
msgid "Translation"
msgstr "平行移動"

#: print_and_cut/wizard.py
msgid "Rotation"
msgstr "回転"

#: print_and_cut/wizard.py
msgid "Allow scaling"
msgstr "スケーリングを許可"

#: print_and_cut/wizard.py
msgid "Scale"
msgstr "スケール"

#: print_and_cut/wizard.py
msgid "Point picked"
msgstr "ポイントが選択されました"

#: print_and_cut/wizard.py
msgid "Click on the second alignment point on the design."
msgstr "デザイン上の2番目の位置合わせポイントをクリックしてください。"

#: print_and_cut/wizard.py
msgid "Both points selected. Click Next to continue."
msgstr "両方のポイントが選択されました。[次へ]をクリックして続行してください。"

#: print_and_cut/wizard.py
msgid "Points are too close. Pick points further apart."
msgstr "ポイントが近すぎます。離れた位置のポイントを選択してください。"

#: print_and_cut/wizard.py
msgid "Turn on laser at focus power to locate position"
msgstr "位置を確認するためにフォーカス出力でレーザーを点灯します"

#: print_and_cut/wizard.py
msgid "Set a focus power in laser preferences to enable"
msgstr "有効にするにはレーザー設定でフォーカス出力を設定してください"

#: print_and_cut/wizard.py
msgid "Record positions at the pointer dot instead of the beam"
msgstr "ビームではなくポインターのドット位置で位置を記録します"

#: print_and_cut/wizard.py
msgid "Requires a pointer offset on the laser head"
msgstr "レーザーヘッドでのポインターオフセットが必要です"

#: print_and_cut/wizard.py
msgid ""
"Note: Scale is locked. Point 2 may not align exactly if the physical "
"distance differs from the design distance."
msgstr ""
"注: スケールがロックされています。物理的な距離がデザイン上の距離と異なる場合、ポイント 2 が正確に一致しないことがあります。"

#: print_and_cut/wizard.py
msgid "Alignment applied"
msgstr "位置合わせが適用されました"